"use client";
import { useEffect, useState } from "react";

type Props = {
  subjectsCount: number;
  addonsCount: number;
  distinctLevelsCount: number; // déjà passé par PanierTabs
  plan: "Normal" | "Gold" | "Platine";
  period: "Mensuel" | "Annuel";
  onPlanChange: (p: Props["plan"]) => void;
  onPeriodChange: (p: Props["period"]) => void;
};

type ApiResp = {
  ok: boolean;
  total: number;
  total_human?: string;
  total_period?: "month" | "year";
  breakdown?: {
    subjectsCount: number;
    distinctLevelsCount: number;
    pricePerSubjectMonthly: number;
    baseMonthly: number;
    addons: number;
    addonsMonthly: number;
    familyPackApplied: number;       // 0 ou 0.2
    period: "Mensuel" | "Annuel";
    annualDiscountApplied: number;   // 0 ou 0.2
    plan: "Normal" | "Gold" | "Platine";
  };
  error?: string;
};

function humanEUR(n: number) {
  return n.toLocaleString("fr-FR", { style: "currency", currency: "EUR" });
}

export default function SummaryBar({
  subjectsCount, addonsCount, distinctLevelsCount, plan, period, onPlanChange, onPeriodChange
}: Props) {
  const [total, setTotal] = useState<string>("…");
  const [loading, setLoading] = useState(false);
  const [err, setErr] = useState<string | null>(null);

  // Nouveaux états pour l’affichage des bannières
  const [familyActive, setFamilyActive] = useState(false);
  const [annualActive, setAnnualActive] = useState(false);
  const [familySavingsMonthly, setFamilySavingsMonthly] = useState<number>(0); // économie / mois
  const [annualSavingsYearly, setAnnualSavingsYearly]   = useState<number>(0); // économie / an

  useEffect(() => {
    let cancelled = false;
    (async () => {
      setLoading(true); setErr(null);
      try {
        const res = await fetch("/api/cart/price", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            subjectsCount,
            plan,
            period,
            addons: addonsCount,
            distinctLevelsCount,
          }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data: ApiResp = await res.json();

        if (!cancelled) {
          setTotal(data.total_human ?? (Number.isFinite(data.total) ? humanEUR(data.total) : "—"));

          const b = data.breakdown;
          if (b) {
            // Avant remises
            const monthlyBefore = (b.baseMonthly ?? 0) + (b.addonsMonthly ?? 0);

            // Pack famille
            const famRate = b.familyPackApplied ?? 0;
            const familySavings = monthlyBefore * famRate;
            const monthlyAfterFamily = monthlyBefore * (1 - famRate);

            // Annuel
            const annRate = period === "Annuel" ? (b.annualDiscountApplied ?? 0) : 0;
            const yearlyBeforeAnnual = monthlyAfterFamily * 12;
            const annualSavings = yearlyBeforeAnnual * annRate;

            setFamilyActive(famRate > 0);
            setAnnualActive(annRate > 0);
            setFamilySavingsMonthly(Math.round(familySavings * 100) / 100);
            setAnnualSavingsYearly(Math.round(annualSavings * 100) / 100);
          } else {
            setFamilyActive(false);
            setAnnualActive(false);
            setFamilySavingsMonthly(0);
            setAnnualSavingsYearly(0);
          }
        }
      } catch (e: any) {
        if (!cancelled) {
          setErr("Erreur de calcul");
          setFamilyActive(false);
          setAnnualActive(false);
          setFamilySavingsMonthly(0);
          setAnnualSavingsYearly(0);
        }
      } finally {
        if (!cancelled) setLoading(false);
      }
    })();
    return () => { cancelled = true; };
  }, [subjectsCount, plan, period, addonsCount, distinctLevelsCount]);

  const showFamilyHint = distinctLevelsCount >= 2;

  return (
    <div className="rounded-2xl border border-emerald-300/20 bg-emerald-300/5 p-4 md:p-5">
      <div className="flex flex-col md:flex-row md:items-center gap-3 md:gap-6">
        <div className="text-lg">
          <span className="opacity-80">Formule</span>{" "}
          <select
            value={plan}
            onChange={(e) => onPlanChange(e.target.value as any)}
            className="bg-white border border-gray-300 text-gray-900 rounded-lg px-2 py-1"
          >
            <option>Normal</option>
            <option>Gold</option>
            <option>Platine</option>
          </select>
          <span className="mx-3 opacity-50">•</span>
          <span className="opacity-80">Durée</span>{" "}
          <select
            value={period}
            onChange={(e) => onPeriodChange(e.target.value as any)}
            className="bg-white border border-gray-300 text-gray-900 rounded-lg px-2 py-1"
          >
            <option>Mensuel</option>
            <option>Annuel</option>
          </select>
        </div>

        <div className="md:ml-auto text-xl">
          {err ? (
            <span className="text-red-600">{err}</span>
          ) : loading ? (
            <span className="opacity-60">Calcul en cours…</span>
          ) : (
            <span>💶 Total : <strong>{total}</strong></span>
          )}
        </div>

        <button
          className="bg-emerald-500 hover:bg-emerald-400 text-black font-medium px-4 py-2 rounded-lg"
          onClick={() => alert("Paiement simulé ✅")}
        >
          Paiement simulé
        </button>
      </div>

      {/* Badges de remises */}
      <div className="mt-3 flex flex-wrap items-center gap-2">
        {familyActive && (
          <div
            className="inline-flex items-center gap-2 rounded-full border border-emerald-400/50 bg-emerald-50 px-3 py-1 text-emerald-700 shadow-sm"
            aria-label="Pack famille actif: remise 20%"
            title="Remise -20% appliquée car au moins deux niveaux différents"
          >
            <span className="text-base">🎯</span>
            <span className="text-sm font-medium">Pack Famille −20%</span>
            {familySavingsMonthly > 0 && (
              <span className="text-xs opacity-80">({`−${humanEUR(familySavingsMonthly)} / mois`})</span>
            )}
          </div>
        )}

        {annualActive && (
          <div
            className="inline-flex items-center gap-2 rounded-full border border-blue-400/50 bg-blue-50 px-3 py-1 text-blue-700 shadow-sm"
            aria-label="Remise annuelle active: 20%"
            title="Remise -20% appliquée sur le total annuel"
          >
            <span className="text-base">📆</span>
            <span className="text-sm font-medium">Annuel −20%</span>
            {annualSavingsYearly > 0 && (
              <span className="text-xs opacity-80">({`−${humanEUR(annualSavingsYearly)} / an`})</span>
            )}
          </div>
        )}
      </div>

      {/* Hint pédagogique */}
      <p className="mt-2 text-sm text-gray-700">
        {showFamilyHint
          ? <>Pack famille <strong>−20%</strong> appliqué (niveaux différents). En <strong>Annuel</strong>, une remise <strong>−20%</strong> s’ajoute sur le total.</>
          : <>Astuce : ajoute un <strong>2ᵉ niveau</strong> pour activer le pack famille <strong>−20%</strong>. En <strong>Annuel</strong>, <strong>−20%</strong> de plus sur l’année.</>}
      </p>
    </div>
  );
}
