import { NextResponse } from "next/server";
import { getGcClient } from "@/lib/gocardless";

export async function POST(req: Request) {
  try {
    const { redirect_flow_id, session_token } = await req.json();

    // getGcClient est async + peut ne pas être dispo en dev si le SDK n'est pas installé
    let gc: any;
    try {
      gc = await getGcClient();
    } catch {
      return NextResponse.json(
        { ok: false, error: "GoCardless non configuré (dev). Réessaie en prod." },
        { status: 503 }
      );
    }

    // Appel GoCardless "réel" (décommente en prod et enlève le mock)
    // const completed = await gc.redirectFlows.complete(redirect_flow_id, { params: { session_token } });
    // const { links } = completed.redirect_flows;
    // return NextResponse.json({ ok: true, customer: links?.customer, mandate: links?.mandate });

    // Mock en dev pour ne pas bloquer la build
    return NextResponse.json({
      ok: true,
      mock: true,
      redirect_flow_id,
      session_token
    });
  } catch (e: any) {
    return NextResponse.json({ ok: false, error: "Erreur serveur GC" }, { status: 500 });
  }
}
